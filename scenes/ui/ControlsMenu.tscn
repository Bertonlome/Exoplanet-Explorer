[node name="ControlReference" type="RichTextLabel" parent="MarginContainer/PanelContainer/MarginContainer/VBoxContainer/ScrollContainer"]
custom_minimum_size = Vector2(1360, 0)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 2
mouse_filter = 1
theme_override_colors/default_color = Color(0.92, 0.95, 0.98, 1)
theme_override_colors/font_selected_color = Color(0.02, 0.04, 0.06, 1)
theme_override_colors/selection_color = Color(0.243137, 0.890196, 0.717647, 1)
theme_override_constants/table_v_separation = 4
theme_override_constants/table_h_separation = 36
theme_override_constants/line_separation = 5
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[font_size=28][color=#3EE3FF]WORLD AND ROBOTS[/color][/font_size]

[table=2]
[cell][b]Left-click robot[/b][/cell][cell]Select or switch units.[/cell]
[cell][b]Left-click empty terrain[/b][/cell][cell]Deselect the current unit.[/cell]
[cell][b]Right-click terrain[/b][/cell][cell]Move to the target.[/cell]
[cell][b]W / A / S / D[/b][/cell][cell]Move one tile north / west / south / east.[/cell]
[cell][b]B[/b][/cell][cell]Open Custom Path mode.[/cell]
[/table]

[font_size=28][color=#3EE3FF]CAMERA, MINIMAP, AND RADAR[/color][/font_size]

[table=2]
[cell][b]Left-drag terrain[/b][/cell][cell]Pan the camera.[/cell]
[cell][b]Arrow keys[/b][/cell][cell]Pan the camera.[/cell]
[cell][b]Mouse wheel[/b][/cell][cell]Zoom in / out.[/cell]
[cell][b]Space[/b][/cell][cell]Center on the pointer.[/cell]
[cell][b]Click / drag minimap[/b][/cell][cell]Move the camera viewport.[/cell]
[cell][b]Wheel over minimap[/b][/cell][cell]Zoom in larger steps.[/cell]
[cell][b]Left-drag anomaly radar[/b][/cell][cell]Rotate the 3D view.[/cell]
[cell][b]Wheel over anomaly radar[/b][/cell][cell]Zoom the 3D view.[/cell]
[/table]

[font_size=28][color=#3EE3FF]DEPLOYMENT[/color][/font_size]

[table=2]
[cell][b]Left-click deployment button[/b][/cell][cell]Choose an object to place.[/cell]
[cell][b]Left-click valid tile[/b][/cell][cell]Place the object.[/cell]
[cell][b]Right-click / Escape[/b][/cell][cell]Cancel placement.[/cell]
[/table]

[font_size=28][color=#3EE3FF]CUSTOM PATH AND RAKE[/color][/font_size]

[table=2]
[cell][b]Left-click / drag[/b][/cell][cell]Paint a path.[/cell]
[cell][b]Right-click / drag[/b][/cell][cell]Avoid tiles and recalculate the path.[/cell]
[cell][b]N, then left-click tile[/b][/cell][cell]Add or edit an annotation.[/cell]
[cell][b]B / Escape while annotating[/b][/cell][cell]Return to painting.[/cell]
[cell][b]Left-click rake[/b][/cell][cell]Pick up, press, or release it.[/cell]
[cell][b]Right-click with rake[/b][/cell][cell]Place it.[/cell]
[cell][b]+ / -[/b][/cell][cell]Resize the held rake.[/cell]
[cell][b]Enter[/b][/cell][cell]Rotate the held rake.[/cell]
[cell][b]Escape[/b][/cell][cell]Cancel the path or held rake.[/cell]
[/table]

[font_size=28][color=#3EE3FF]FRAGMENT ANALYSIS[/color][/font_size]

[table=2]
[cell][b]Left-drag canvas[/b][/cell][cell]Pan, or draw with the active tool.[/cell]
[cell][b]Arrow keys[/b][/cell][cell]Pan the fragment view.[/cell]
[cell][b]Mouse wheel[/b][/cell][cell]Zoom the fragment view.[/cell]
[cell][b]Double-click region[/b][/cell][cell]Select and drag to resize it.[/cell]
[cell][b]Delete / Backspace[/b][/cell][cell]Delete the selected editable item.[/cell]
[cell][b]Right-click / Escape[/b][/cell][cell]Cancel the active edit.[/cell]
[/table]

[font_size=28][color=#3EE3FF]MENUS[/color][/font_size]

[table=2]
[cell][b]Escape[/b][/cell][cell]Open / close the pause menu.[/cell]
[/table]"
fit_content = true
selection_enabled = true

